# OpsFlow Backend — Environment Configuration
# Copy this file to .env and update with your actual values

# ========== DATABASE ==========
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# For Railway: Copy the PostgreSQL_URL from Railway dashboard
DATABASE_URL="postgresql://postgres:password@localhost:5432/opsflow_v2"

# ========== JWT AUTHENTICATION ==========
# Secret key for signing access tokens (minimum 32 characters, random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate-a-strong-random-key-at-least-32-chars-long-here"

# Secret key for signing refresh tokens (minimum 32 characters, random)
JWT_REFRESH_SECRET="generate-another-strong-random-key-at-least-32-chars"

# JWT expiration time (e.g., "7d", "24h", "1w")
JWT_EXPIRES_IN="7d"

# ========== ENCRYPTION ==========
# AES-256 encryption key for sensitive data (exactly 32 characters for AES-256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="32-character-hex-string-for-aes256-encryption"

# ========== ADMIN ACCOUNT ==========
# Password for the initial super admin account
# This is used when running npm run db:seed
# Make this strong in production!
SUPERADMIN_PASSWORD="YourSecurePasswordHere123!"

# ========== SERVER ==========
# Server port (default: 5000)
PORT=5000

# Node environment: "development" or "production"
NODE_ENV="development"

# ========== FRONTEND ==========
# Frontend URL for CORS configuration
# Must match your deployed frontend domain
FRONTEND_URL="http://localhost:3000"

# ========== OPTIONAL: FILE STORAGE ==========
# Uncomment if using cloud storage
# AWS_S3_BUCKET=""
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ========== OPTIONAL: EMAIL SERVICE ==========
# Uncomment if sending emails
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="noreply@opsflow.com"

# ========== OPTIONAL: LOGGING ==========
# Log level: "debug", "info", "warn", "error"
# LOG_LEVEL="info"
